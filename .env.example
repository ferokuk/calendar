# Обязательные значения
TG_BOT_TOKEN=1234567890:replace_with_token_from_BotFather
ADMIN_CHAT_ID=123456789
RUZ_GROUP_ID=154832

# Период и фильтрация расписания
RUZ_DAYS_AHEAD=60
RUZ_CHUNK_DAYS=7
SUBGROUP_MARKER=(КАЯиПК)
SUBGROUP_FILTER=(КАЯиПК)-2
SCHEDULE_CRON=0 */6 * * *

# Общие каталоги внутри контейнеров
CALENDARS_DIR=/app/calendars
DATA_DIR=/app/data

# HTTP и повторные попытки
HTTP_TIMEOUT=15
HTTP_RETRIES=4
HTTP_BACKOFF=3
HTTP_BACKOFF_MAX=60
FETCH_DELAY=1
RUZ_API_URL=https://ruz.fa.ru/api/schedule/group

# Уведомления
ALERTS_ENABLED=true
ALERT_COOLDOWN_MINUTES=60

# Домашние задания
HOMEWORK_RETENTION_DAYS=14
HOMEWORK_CLEANUP_HOUR=4

# Логи и время
LOG_LEVEL=INFO
TZ=Europe/Moscow
TZ_LABEL=MSK
