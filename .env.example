# Обязательные значения
TG_BOT_TOKEN=1234567890:replace_with_token_from_BotFather
ADMIN_CHAT_ID=123456789
RUZ_GROUP_ID=154832

# Канал с #дз и #кр (-100…). Посты из других каналов бот игнорирует.
# Пусто — принимать из любого канала, где бот админ; id последнего
# канала с постом видно в админке → 📊 Статус.
HOMEWORK_CHANNEL_ID=

# Период расписания (все подгруппы включены).
# Прошлые пары остаются в календарях SCHEDULE_HISTORY_DAYS дней.
SCHEDULE_HISTORY_DAYS=30
RUZ_DAYS_AHEAD=60
RUZ_CHUNK_DAYS=31
SCHEDULE_CRON=0 */6 * * *

# После сбоя — фоновые повторы через 1, 2, 4, 8 и затем каждые 15 минут.
# Cron проверяет срок повтора раз в минуту; ручное обновление не требуется.
SCHEDULE_RETRY_SECONDS=60
SCHEDULE_RETRY_MAX_SECONDS=900

# Общие каталоги внутри контейнеров
CALENDARS_DIR=/app/calendars
DATA_DIR=/app/data

# HTTP и повторные попытки
HTTP_TIMEOUT=15
HTTP_RETRIES=4
HTTP_BACKOFF=3
HTTP_BACKOFF_MAX=60
FETCH_DELAY=1
RUZ_API_URL=https://ruz.fa.ru/api/schedule/group

# Уведомления
ALERTS_ENABLED=true
ALERT_COOLDOWN_MINUTES=60

# Домашние задания
HOMEWORK_RETENTION_DAYS=14
HOMEWORK_CLEANUP_HOUR=4

# Логи и время
LOG_LEVEL=INFO
TZ=Europe/Moscow
TZ_LABEL=MSK
